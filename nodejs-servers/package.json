{
  "name": "etherflow-node",
  "version": "1.0.0",
  "description": "EtherFlow HTTP client for Node.js and TypeScript — mirrors the Java/Kotlin builder API",
  "main": "etherflow-client.js",
  "types": "etherflow-client.d.ts",
  "scripts": {
    "start":      "node express-server.js",
    "dev":        "node --watch express-server.js",
    "build":      "tsc --project tsconfig.json",
    "typecheck":  "tsc --noEmit",
    "test":       "node --test"
  },
  "keywords": ["etherflow", "http-client", "reactive", "nodejs", "typescript"],
  "author": "kvarun701",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node":    "^20.11.0",
    "typescript":     "^5.3.3"
  }
}
